STAGING_DOMAIN=staging.example.com
STAGING_IMAGE=ticket-online-api:replace-with-commit-sha
STAGING_DB_NAME=ticket_online_staging
STAGING_DB_USER=ticket
STAGING_DB_PASSWORD=replace-with-64-hex-characters
STAGING_DB_BACKUP_PASSWORD=replace-with-64-hex-characters
STAGING_DB_ROOT_PASSWORD=replace-with-64-hex-characters
STAGING_MYSQL_DSN=ticket:replace-with-64-hex-characters@tcp(db:3306)/ticket_online_staging?parseTime=true&loc=UTC
ORDER_ACCESS_SECRET=replace-with-base64-32-random-bytes
MIDTRANS_SERVER_KEY=replace-with-sandbox-key
MIDTRANS_ENV=sandbox
MIDTRANS_REFUND_METHODS=
TRANSACTIONS_ENABLED=true
SMTP_HOST=replace-with-sandbox-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-sandbox-user
SMTP_PASSWORD=replace-with-sandbox-password
SMTP_FROM=staging@example.com
SMTP_TLS_MODE=starttls
S3_URI=s3://replace-with-dedicated-bucket/ticket-online-staging/backups
S3_ENDPOINT_URL=
AWS_PROFILE=ticket-online-staging
AGE_RECIPIENT=replace-with-age1-recipient

# Private poster bucket, separate from database backups and the other environment.
# Leave bucket empty to disable upload (URL posters still work).
STAGING_POSTER_S3_BUCKET=
STAGING_POSTER_S3_REGION=ap-southeast-1
STAGING_POSTER_S3_ENDPOINT=
STAGING_POSTER_S3_PREFIX=posters
# Prefer an instance/workload role. These are optional SDK credentials, backend only.
STAGING_POSTER_AWS_ACCESS_KEY_ID=
STAGING_POSTER_AWS_SECRET_ACCESS_KEY=
STAGING_POSTER_AWS_SESSION_TOKEN=
